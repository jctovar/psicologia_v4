# ========================================
# Configuración Firebase
# ========================================

# ID del proyecto Firebase
FIREBASE_PROJECT_ID=app-de-psicologia-suayed

# Ruta al archivo service account JSON
# Descargar desde Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# ========================================
# FCM Tokens
# ========================================

# Token FCM del dispositivo de prueba
# Obtener desde los logs de la app Flutter o desde Firebase Console
# Para múltiples tokens, separa con comas (sin espacios)
FCM_TOKEN=d3L0Hy_HQxmsm7bsx09R_M:APA91bGukufLhe9Rgi7rxGH1kPEXgWJMPxbWDznKOEGYzJkoYJaPodEhfsl3v0Tq_t_AEkG4fZ6UWTQUwrQd_sFEhjk5gVzs6R1fiC_JvPcOhSeGjJd7lkQ

# Tokens adicionales de prueba (opcional)
# FCM_TOKEN_IOS=otro-token-ios-aqui
# FCM_TOKEN_ANDROID=otro-token-android-aqui

# ========================================
# Configuración de Notificación por Defecto
# ========================================

# Título por defecto cuando no se especifica con --title
DEFAULT_TITLE=Psicología SUAyED

# Cuerpo del mensaje por defecto cuando no se especifica con --body
DEFAULT_BODY=Tienes una nueva notificación de la aplicación SUAyED

# Icono de notificación (Android)
# Debe coincidir con el nombre del drawable en android/app/src/main/res/
DEFAULT_ICON=notification_icon

# Sonido de notificación
# 'default' usa el sonido por defecto del sistema
DEFAULT_SOUND=default

# Canal de notificación (Android)
# Debe coincidir con el canal configurado en la app Flutter
DEFAULT_CHANNEL_ID=high_importance_channel

# ========================================
# Configuración Avanzada (Opcional)
# ========================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Archivo de log
LOG_FILE=notification.log

# Modo de desarrollo (true/false)
# En modo desarrollo se muestran más detalles en los logs
DEV_MODE=true

# ========================================
# Ejemplos de Uso
# ========================================

# Envío básico (usa valores por defecto):
#   uv run python send_notification.py

# Envío personalizado:
#   uv run python send_notification.py --title "Nuevo Evento" --body "Conferencia de Psicología"

# Envío con datos personalizados:
#   uv run python send_notification.py --data '{"type":"post","id":"123","action":"view"}'

# Envío a token específico:
#   uv run python send_notification.py --token "OTRO_TOKEN_AQUI" --title "Hola"

# Envío multicast (múltiples dispositivos):
#   uv run python send_notification.py --tokens "TOKEN1,TOKEN2,TOKEN3" --title "Hola a todos"

# Envío con imagen:
#   uv run python send_notification.py --title "Evento" --image "https://ejemplo.com/imagen.jpg"
